set bind-root false

# parameters in function definition
# match functionDecl(
#   isDefinition(),
#   unless(isImplicit()),
#   hasAnyParameter(anything())
# ).bind("fn")

let declInIfStmt varDecl(
  hasParent(
    declStmt(hasParent(ifStmt()))
  )
).bind("varInIf")

# all local variables
match varDecl(
  unless(parmVarDecl()),
  unless(declInIfStmt),
  isDefinition(),
  hasAncestor(
    functionDecl(isDefinition())
  )
).bind("normalVar")

match declInIfStmt
