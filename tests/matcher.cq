set bind-root false

# in callback, iterate over arguments and check if they're used
match functionDecl(
  isDefinition(),
  unless(isImplicit()),
  hasAnyParameter(anything())
).bind("fn")

match varDecl(
  unless(parmVarDecl()),
  isDefinition(),
  hasAncestor(
    functionDecl(isDefinition())
  )
).bind("var")
